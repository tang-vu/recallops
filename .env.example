# Resolve this to an absolute path in production.
RECALLOPS_MEMORY_DB=.data/local/recallops.db

# Generate a high-entropy local value. Administrative writes remain disabled when empty.
RECALLOPS_ADMIN_TOKEN=

# Partner modes must reflect reality. Do not label fixture output as live.
RECALLOPS_VIRTUALS_MODE=FIXTURE MODE
RECALLOPS_BASE_MODE=NOT CONFIGURED

# Local Anvil only. See docs/base-deployment.md before configuring Base Sepolia.
# RECALLOPS_BASE_RPC_URL=http://127.0.0.1:8545
# RECALLOPS_BASE_CONTRACT_ADDRESS=0x...
# RECALLOPS_BASE_SUBMITTER=0x...
